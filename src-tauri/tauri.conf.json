{
  "$schema": "https://tauri.app/v2/schema.json",
  "identifier": "com.xvg.desktop",
  "productName": "XVG Desktop",
  "version": "1.0.0",
  "build": {
    "frontendDist": "S:/xvg-tesseract/xvg-desktop/dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "XVG Desktop",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
} 