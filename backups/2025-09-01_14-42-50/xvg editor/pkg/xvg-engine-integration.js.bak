class RealFileEngine {
    constructor(xvgWasm) {
        this.xvgWasm = xvgWasm;
        this.initialized = false;
        this.instances = [];
    }

    async init() {
        try {
            if (!this.xvgWasm) {
                console.warn("⚠️ WASM not available for File engine");
