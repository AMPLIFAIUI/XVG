{
  "name": "xvg-editor",
  "version": "1.0.0",
  "description": "XVG (eXtended Vector Graphics) Editor - WebAssembly Frontend",
  "main": "index.html",
  "scripts": {
    "build:wasm": "cd ../xvg-wasm && wasm-pack build --target web --out-dir ../xvg-editor/modules --out-name xvg_wasm",
    "prebuild": "npm run build:wasm",
    "start": "http-server . -c-1",
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "xvg",
    "wasm",
    "rust",
    "webgpu"
  ],
  "author": "xvg-team",
  "license": "MIT",
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  }
}
