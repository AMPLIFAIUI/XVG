{
  "name": "xvg-editor",
  "type": "module",
  "version": "1.0.0",
  "description": "Professional vector graphics editor with XVG format support, advanced engines (SDF, 3D, WGSL, CRDT), and real-time collaboration",
  "keywords": [
    "vector-graphics",
    "editor",
    "xvg",
    "svg",
    "graphics",
    "drawing",
    "design",
    "canvas",
    "wasm",
    "webassembly",
    "sdf",
    "neural-networks",
    "3d",
    "shaders",
    "crdt",
    "collaboration"
  ],
  "author": {
    "name": "XVG Project Team",
    "email": "team@xvg-project.org",
    "url": "https://xvg-project.org"
  },
  "homepage": "https://xvg-project.org/editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/xvg-project/xvg-editor.git",
    "directory": "xvg editor"
  },
  "bugs": {
    "url": "https://github.com/xvg-project/xvg-editor/issues",
    "email": "bugs@xvg-project.org"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "xvg_wasm_bg.wasm",
    "xvg_wasm.js",
    "xvg_wasm.d.ts",
    "xvg-core.js",
    "xvg-tools.js",
    "xvg-utilities.js",
    "xvg-engine-integration.js",
    "index.html",
    "styles.css",
    "server.js",
    "assets/**/*"
  ],
  "main": "xvg_wasm.js",
  "types": "xvg_wasm.d.ts",
  "sideEffects": [
    "./snippets/*"
  ],
  "scripts": {
    "dev": "node server.js",
    "build": "npm run build:wasm && npm run build:assets && npm run build:bundle",
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:assets": "npm run optimize:assets",
    "build:bundle": "webpack --mode production",
    "test": "node tests/test-automation.js",
    "test:unit": "node tests/test-automation.js --unit",
    "test:integration": "node tests/test-automation.js --integration",
    "test:watch": "nodemon tests/test-automation.js",
    "test:browser": "http-server tests -p 8080 -o",
    "lint": "eslint . --ext .js,.html,.css",
    "lint:fix": "eslint . --ext .js,.html,.css --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:assets": "npm run compress:images && npm run bundle:assets",
    "compress:images": "imagemin assets/**/*.{png,jpg,jpeg} --out-dir=assets/compressed",
    "bundle:assets": "webpack --config webpack.assets.config.js",
    "serve": "http-server . -p 8080 -c-1",
    "start": "npm run dev",
    "preview": "npm run build && npm run serve",
    "clean": "rm -rf dist/ node_modules/.cache/",
    "postinstall": "npm run build:wasm"
  },
  "dependencies": {
    "http-server": "^14.1.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.45.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.0.0",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^29.6.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/dom": "^9.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "imagemin": "^8.0.1",
    "imagemin-pngquant": "^9.0.2",
    "imagemin-mozjpeg": "^10.0.0",
    "wasm-pack": "^0.12.1",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}